# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# ── FinanceBench data & artifacts (regenerated by the bench harness) ──────────
# PDFs are redistributable (FinanceBench is open source) but kept out of git;
# re-download with: just bench-fetch
data/pdfs/
# Ladybug (Kuzu) Document Graph database
data/kg/
# Caches (markdownize manifest, llm cache, hf models)
data/.cache/
data/llm_cache/
data/hf_models/
data/markdown/.cache/
# Full OCR markdown (regenerated by just bench-build; a small sample is committed
# under data/markdown_sample/ for reference)
data/markdown/
# Run / score / trajectory outputs (regenerated)
data/financebench/runs.jsonl
data/financebench/scores.jsonl
data/financebench/scores_summary.json
data/trajectories/
data/traces/
# Cached HF dataset (regenerated from HF)
data/financebench/financebench_merged.parquet
# genai-tk model-catalog snapshots (large, regenerated by genai-tk)
data/edenai_models.json
data/edenai_eur_models.json
data/models_dev.json

